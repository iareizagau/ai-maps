{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django: Run Server (Select ENV+Port)",
            "type": "debugpy",
            "request": "launch",
            "python": "/usr/local/bin/python",
            "program": "${workspaceFolder}/src/manage.py",
            "args": [
                "runserver",
                "0.0.0.0:${input:portSelect}"
            ],
            "django": true,
            "justMyCode": true,
            "env": {
                "ENV": "${input:envSelect}"
            }
        },
        {
            "name": "Django: Run Server (Maps :9900)",
            "type": "debugpy",
            "request": "launch",
            "python": "/usr/local/bin/python",
            "program": "${workspaceFolder}/src/manage.py",
            "args": [
                "runserver",
                "0.0.0.0:9900"
            ],
            "django": true,
            "justMyCode": true,
            "env": {
                "ENV": "maps"
            }
        },
        {
            "name": "Django: Run Server (Estrata :9000)",
            "type": "debugpy",
            "request": "launch",
            "python": "/usr/local/bin/python",
            "program": "${workspaceFolder}/src/manage.py",
            "args": [
                "runserver",
                "0.0.0.0:9000"
            ],
            "django": true,
            "justMyCode": true,
            "env": {
                "ENV": "estrata"
            }
        },
        {
            "name": "Django: Run Management Command",
            "type": "debugpy",
            "request": "launch",
            "python": "/usr/local/bin/python",
            "program": "${workspaceFolder}/src/manage.py",
            "args": [
                "${input:manageCommand}"
            ],
            "django": true,
            "justMyCode": true,
            "env": {
                "ENV": "${input:envSelect}"
            }
        }
    ],
    "inputs": [
        {
            "id": "envSelect",
            "type": "pickString",
            "description": "Selecciona el entorno (ENV)",
            "options": [
                "maps",
                "estrata"
            ],
            "default": "maps"
        },
        {
            "id": "portSelect",
            "type": "pickString",
            "description": "Puerto de runserver",
            "options": [
                "9900",
                "9000",
                "9001",
                "9002",
                "9003"
            ],
            "default": "9900"
        },
        {
            "id": "manageCommand",
            "type": "pickString",
            "description": "Comando de Django",
            "options": [
                "makemigrations",
                "migrate",
                "init_apps",
                "seed_pintxos",
                "seed_mock_data",
                "seed_inguru",
                "load_events",
                "load_sbk_events",
                "shell"
            ],
            "default": "makemigrations"
        }
    ]
}
