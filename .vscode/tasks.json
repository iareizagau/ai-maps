{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Django: Run Command",
            "type": "shell",
            "command": "python src/manage.py ${input:manageCommand}",
            "options": {
                "env": {
                    "ENV": "${input:envSelect}"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Django: Make Messages",
            "type": "shell",
            "command": "cd src && python manage.py makemessages -l eu -l es -l en",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Django: Compile Messages",
            "type": "shell",
            "command": "cd src && python manage.py compilemessages",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Django: Seed All",
            "type": "shell",
            "command": "cd src && python manage.py seed_pintxos && python manage.py seed_mock_data && python manage.py seed_inguru && python manage.py load_events && python manage.py load_sbk_events",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "envSelect",
            "type": "pickString",
            "description": "Selecciona el entorno (ENV)",
            "options": [
                "maps",
                "estrata"
            ],
            "default": "maps"
        },
        {
            "id": "manageCommand",
            "type": "pickString",
            "description": "Comando de Django",
            "options": [
                "makemigrations",
                "migrate",
                "init_apps",
                "seed_pintxos",
                "seed_mock_data",
                "seed_inguru",
                "load_events",
                "load_sbk_events"
            ],
            "default": "makemigrations"
        }
    ]
}
